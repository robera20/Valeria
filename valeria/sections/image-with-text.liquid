{%- comment -%}
  VALERIA IMAGE WITH TEXT SECTION
{%- endcomment -%}

<section class="valeria-image-with-text">
  <div class="valeria-container">
    <div class="valeria-image-with-text__layout" data-layout="{{ section.settings.layout }}">
      <div class="valeria-image-with-text__image">
        {%- if section.settings.image -%}
          {{ section.settings.image | img_tag: '', loading: 'lazy' }}
        {%- else -%}
          <div class="valeria-placeholder">No image selected</div>
        {%- endif -%}
      </div>

      <div class="valeria-image-with-text__content">
        {%- if section.settings.heading -%}
          <h2 class="valeria-image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text -%}
          <div class="valeria-image-with-text__text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label -%}
          <a href="{{ section.settings.button_link }}" class="valeria-button valeria-button--primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .valeria-image-with-text {
    padding: var(--valeria-space-6) var(--valeria-space-3);
  }

  .valeria-image-with-text__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--valeria-space-6);
    align-items: center;
  }

  .valeria-image-with-text__layout[data-layout="image-right"] {
    grid-template-columns: 1fr 1fr;
  }

  .valeria-image-with-text__layout[data-layout="image-left"] {
    grid-template-columns: 1fr 1fr;
  }

  .valeria-image-with-text__layout[data-layout="image-left"] .valeria-image-with-text__image {
    order: -1;
  }

  .valeria-image-with-text__image {
    border-radius: var(--valeria-radius-lg);
    overflow: hidden;
    aspect-ratio: 1;
  }

  .valeria-image-with-text__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .valeria-image-with-text__heading {
    font-size: var(--valeria-font-size-h1);
    margin-bottom: var(--valeria-space-3);
  }

  .valeria-image-with-text__text {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: var(--valeria-space-4);
  }

  .valeria-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--valeria-color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--valeria-color-text);
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .valeria-image-with-text__layout {
      grid-template-columns: 1fr;
      gap: var(--valeria-space-4);
    }

    .valeria-image-with-text__layout[data-layout="image-left"] .valeria-image-with-text__image {
      order: 0;
    }

    .valeria-image-with-text__heading {
      font-size: 1.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image-right", "label": "Image Right" },
        { "value": "image-left", "label": "Image Left" }
      ],
      "default": "image-right",
      "label": "Layout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
