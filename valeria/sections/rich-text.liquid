{%- comment -%}
  VALERIA RICH TEXT SECTION
{%- endcomment -%}

<section class="valeria-rich-text">
  <div class="valeria-container">
    <div class="valeria-rich-text__content">
      {%- if section.settings.heading -%}
        <h2 class="valeria-rich-text__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text -%}
        <div class="valeria-rich-text__body">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label -%}
        <a href="{{ section.settings.button_link }}" class="valeria-button valeria-button--primary">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .valeria-rich-text {
    padding: var(--valeria-space-6) var(--valeria-space-3);
  }

  .valeria-rich-text__content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .valeria-rich-text__heading {
    font-size: var(--valeria-font-size-h2);
    margin-bottom: var(--valeria-space-4);
  }

  .valeria-rich-text__body {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--valeria-color-text);
    margin-bottom: var(--valeria-space-4);
  }

  .valeria-rich-text__body h2 {
    margin-top: var(--valeria-space-4);
  }

  .valeria-rich-text__body h3 {
    margin-top: var(--valeria-space-3);
  }

  .valeria-rich-text__body p {
    margin-bottom: var(--valeria-space-2);
  }

  .valeria-rich-text__body ul,
  .valeria-rich-text__body ol {
    margin-bottom: var(--valeria-space-3);
    margin-left: var(--valeria-space-4);
    list-style: initial;
  }

  .valeria-rich-text__body li {
    margin-bottom: var(--valeria-space-1);
  }

  @media (max-width: 768px) {
    .valeria-rich-text {
      padding: var(--valeria-space-4) var(--valeria-space-2);
    }

    .valeria-rich-text__body {
      font-size: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Rich Text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
