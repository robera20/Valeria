{%- comment -%}
  VALERIA PRODUCT RECOMMENDATIONS SECTION
{%- endcomment -%}

<section class="valeria-product-recommendations">
  <div class="valeria-container">
    {%- if section.settings.title -%}
      <h2 class="valeria-section-title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if product.metafields.custom.related_products -%}
      {%- assign related_products = product.metafields.custom.related_products -%}
    {%- else -%}
      {%- assign related_products = product.related_products -%}
    {%- endif -%}

    {%- if related_products.size > 0 -%}
      <div class="valeria-product-grid" data-columns="{{ section.settings.columns }}">
        {%- for related_product in related_products limit: section.settings.limit -%}
          <div class="valeria-product-card">
            <div class="valeria-product-card__image">
              {%- if related_product.featured_media -%}
                <a href="{{ related_product.url }}">
                  {{ related_product.featured_media | img_tag: related_product.title, loading: 'lazy' }}
                </a>
              {%- endif -%}
            </div>

            <div class="valeria-product-card__content">
              <h3 class="valeria-product-card__title">
                <a href="{{ related_product.url }}">{{ related_product.title }}</a>
              </h3>

              <div class="valeria-product-card__price">
                {%- if related_product.compare_at_price > related_product.price -%}
                  <span class="valeria-product-card__price-compare">
                    {{ related_product.compare_at_price | money }}
                  </span>
                {%- endif -%}
                <span class="valeria-product-card__price-current">
                  {{ related_product.price | money }}
                </span>
              </div>

              {%- if settings.enable_quick_add -%}
                <form action="/cart/add" method="post" class="valeria-quick-add">
                  <input type="hidden" name="id" value="{{ related_product.variants.first.id }}">
                  <button type="submit" class="valeria-button valeria-button--secondary">
                    Quick Add
                  </button>
                </form>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .valeria-product-recommendations {
    padding: var(--valeria-space-6) var(--valeria-space-3);
    background-color: var(--valeria-color-foreground);
    border-radius: var(--valeria-radius-lg);
    margin: var(--valeria-space-6) var(--valeria-space-3);
  }

  .valeria-section-title {
    text-align: center;
    margin-bottom: var(--valeria-space-6);
    font-size: var(--valeria-font-size-h2);
  }

  .valeria-product-grid {
    display: grid;
    gap: var(--valeria-space-4);
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .valeria-product-grid[data-columns="3"] {
    grid-template-columns: repeat(3, 1fr);
  }

  .valeria-product-grid[data-columns="4"] {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 768px) {
    .valeria-product-recommendations {
      margin: var(--valeria-space-4) var(--valeria-space-2);
    }

    .valeria-product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Product Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of products"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns"
    }
  ]
}
{% endschema %}
