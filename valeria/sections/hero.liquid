{%- comment -%}
  VALERIA HERO SECTION
{%- endcomment -%}

<section class="valeria-hero" style="--hero-height: {{ section.settings.height }};">
  {%- if section.settings.image -%}
    <div class="valeria-hero__image">
      {{ section.settings.image | img_tag: '', loading: 'eager' }}
    </div>
  {%- endif -%}

  {%- if section.settings.overlay -%}
    <div class="valeria-hero__overlay"></div>
  {%- endif -%}

  <div class="valeria-hero__content">
    {%- if section.settings.heading -%}
      <h1 class="valeria-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading -%}
      <p class="valeria-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="valeria-hero__buttons">
      {%- if section.settings.button_1_label -%}
        <a href="{{ section.settings.button_1_link }}" class="valeria-button valeria-button--primary">
          {{ section.settings.button_1_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.button_2_label -%}
        <a href="{{ section.settings.button_2_link }}" class="valeria-button valeria-button--secondary">
          {{ section.settings.button_2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .valeria-hero {
    position: relative;
    overflow: hidden;
    height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .valeria-hero[style*="--hero-height: large"] {
    height: 700px;
  }

  .valeria-hero[style*="--hero-height: medium"] {
    height: 500px;
  }

  .valeria-hero[style*="--hero-height: small"] {
    height: 400px;
  }

  .valeria-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .valeria-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .valeria-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.3);
  }

  .valeria-hero__content {
    position: relative;
    z-index: 2;
    color: white;
    max-width: 600px;
    margin: 0 auto;
    padding: 0 var(--valeria-space-3);
  }

  .valeria-hero__heading {
    font-size: var(--valeria-font-size-display);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--valeria-space-3);
    color: white;
  }

  .valeria-hero__subheading {
    font-size: 1.25rem;
    margin-bottom: var(--valeria-space-4);
    opacity: 0.95;
  }

  .valeria-hero__buttons {
    display: flex;
    gap: var(--valeria-space-2);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .valeria-hero {
      height: 500px;
    }

    .valeria-hero__heading {
      font-size: 2rem;
    }

    .valeria-hero__subheading {
      font-size: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to VALERIA"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>The Future of Commerce</p>"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large",
      "label": "Height"
    },
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 Label"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 Label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
