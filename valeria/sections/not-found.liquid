{%- comment -%}
  VALERIA 404 NOT FOUND SECTION
{%- endcomment -%}

<section class="valeria-not-found">
  <div class="valeria-container">
    <div class="valeria-not-found__content">
      <h1 class="valeria-not-found__code">404</h1>
      <h2 class="valeria-not-found__title">{{ 'general.404.title' | t }}</h2>
      <p class="valeria-not-found__text">{{ 'general.404.subtext' | t }}</p>
      
      <a href="/" class="valeria-button valeria-button--primary">
        Return Home
      </a>
    </div>
  </div>
</section>

<style>
  .valeria-not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--valeria-space-6) var(--valeria-space-3);
  }

  .valeria-not-found__content {
    text-align: center;
    max-width: 600px;
  }

  .valeria-not-found__code {
    font-size: 6rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: var(--valeria-space-2);
    opacity: 0.1;
    letter-spacing: -0.05em;
  }

  .valeria-not-found__title {
    font-size: var(--valeria-font-size-h1);
    margin-bottom: var(--valeria-space-2);
  }

  .valeria-not-found__text {
    font-size: 1.1rem;
    color: var(--valeria-color-text);
    margin-bottom: var(--valeria-space-4);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .valeria-not-found__code {
      font-size: 3rem;
    }

    .valeria-not-found__title {
      font-size: 1.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "Not Found"
}
{% endschema %}
