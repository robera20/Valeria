{%- comment -%}
  VALERIA CONTACT FORM SECTION
{%- endcomment -%}

<section class="valeria-contact-form">
  <div class="valeria-container">
    <div class="valeria-contact-form__inner">
      {%- if section.settings.heading -%}
        <h1 class="valeria-contact-form__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.description -%}
        <p class="valeria-contact-form__description">{{ section.settings.description }}</p>
      {%- endif -%}

      <form method="post" action="/contact" class="valeria-contact-form__form">
        <div class="valeria-form-group">
          <label for="contact-name" class="valeria-form-label">Name</label>
          <input 
            type="text"
            id="contact-name"
            name="contact[Name]"
            required
            class="valeria-form-input"
          >
        </div>

        <div class="valeria-form-group">
          <label for="contact-email" class="valeria-form-label">Email</label>
          <input 
            type="email"
            id="contact-email"
            name="contact[email]"
            required
            class="valeria-form-input"
          >
        </div>

        <div class="valeria-form-group">
          <label for="contact-phone" class="valeria-form-label">Phone (optional)</label>
          <input 
            type="tel"
            id="contact-phone"
            name="contact[Phone]"
            class="valeria-form-input"
          >
        </div>

        <div class="valeria-form-group">
          <label for="contact-message" class="valeria-form-label">Message</label>
          <textarea 
            id="contact-message"
            name="contact[body]"
            required
            rows="6"
            class="valeria-form-input"
          ></textarea>
        </div>

        <button type="submit" class="valeria-button valeria-button--primary">
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .valeria-contact-form {
    padding: var(--valeria-space-6) var(--valeria-space-3);
    min-height: 60vh;
  }

  .valeria-contact-form__inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .valeria-contact-form__heading {
    font-size: var(--valeria-font-size-h1);
    text-align: center;
    margin-bottom: var(--valeria-space-3);
  }

  .valeria-contact-form__description {
    text-align: center;
    margin-bottom: var(--valeria-space-6);
    color: var(--valeria-color-text);
    line-height: 1.6;
  }

  .valeria-form-group {
    margin-bottom: var(--valeria-space-4);
  }

  .valeria-form-label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--valeria-space-1);
    color: var(--valeria-color-heading);
  }

  .valeria-form-input {
    width: 100%;
    padding: var(--valeria-space-2);
    border: 1px solid var(--valeria-color-border);
    border-radius: var(--valeria-radius-md);
    font-family: inherit;
    font-size: 1rem;
    transition: all var(--valeria-transition-fast);
  }

  .valeria-form-input:focus {
    outline: none;
    border-color: var(--valeria-color-accent);
    box-shadow: 0 0 0 3px rgba(0, 102, 255, 0.1);
  }

  .valeria-contact-form__form .valeria-button {
    width: 100%;
    margin-top: var(--valeria-space-2);
  }

  @media (max-width: 768px) {
    .valeria-contact-form {
      padding: var(--valeria-space-4) var(--valeria-space-2);
    }

    .valeria-contact-form__heading {
      font-size: 1.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    }
  ]
}
{% endschema %}
