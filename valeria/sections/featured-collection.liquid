{%- comment -%}
  VALERIA FEATURED COLLECTION SECTION
{%- endcomment -%}

<section class="valeria-featured-collection" data-section-id="{{ section.id }}">
  <div class="valeria-container">
    {%- if section.settings.title -%}
      <h2 class="valeria-section-title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection.products_count > 0 -%}
      <div class="valeria-product-grid" data-columns="{{ section.settings.columns }}">
        {%- for product in collection.products limit: section.settings.limit -%}
          <div class="valeria-product-card">
            <div class="valeria-product-card__image">
              {%- if product.featured_media -%}
                <a href="{{ product.url }}">
                  {{ product.featured_media | img_tag: product.title, loading: 'lazy' }}
                </a>
              {%- endif -%}
            </div>

            <div class="valeria-product-card__content">
              {%- if settings.show_vendor and product.vendor -%}
                <p class="valeria-product-card__vendor">{{ product.vendor }}</p>
              {%- endif -%}

              <h3 class="valeria-product-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <div class="valeria-product-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="valeria-product-card__price-compare">
                    {{ product.compare_at_price | money }}
                  </span>
                {%- endif -%}
                <span class="valeria-product-card__price-current">
                  {{ product.price | money }}
                </span>
              </div>

              {%- if settings.enable_quick_add -%}
                <form action="/cart/add" method="post" class="valeria-quick-add">
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                  <button type="submit" class="valeria-button valeria-button--secondary">
                    Quick Add
                  </button>
                </form>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p>No products found</p>
    {%- endif -%}
  </div>
</section>

<style>
  .valeria-featured-collection {
    padding: var(--valeria-space-6) var(--valeria-space-3);
  }

  .valeria-section-title {
    text-align: center;
    margin-bottom: var(--valeria-space-6);
    font-size: var(--valeria-font-size-h1);
  }

  .valeria-product-grid {
    display: grid;
    gap: var(--valeria-space-4);
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .valeria-product-grid[data-columns="3"] {
    grid-template-columns: repeat(3, 1fr);
  }

  .valeria-product-grid[data-columns="4"] {
    grid-template-columns: repeat(4, 1fr);
  }

  .valeria-product-card {
    display: flex;
    flex-direction: column;
  }

  .valeria-product-card__image {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--valeria-radius-lg);
    background-color: var(--valeria-color-foreground);
    margin-bottom: var(--valeria-space-2);
  }

  .valeria-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .valeria-product-card:hover .valeria-product-card__image img {
    transform: scale(1.05);
  }

  .valeria-product-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .valeria-product-card__vendor {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--valeria-color-text);
    opacity: 0.6;
    margin-bottom: var(--valeria-space-1);
  }

  .valeria-product-card__title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: var(--valeria-space-1);
  }

  .valeria-product-card__title a {
    color: var(--valeria-color-heading);
  }

  .valeria-product-card__price {
    display: flex;
    gap: var(--valeria-space-1);
    margin-bottom: var(--valeria-space-2);
    font-weight: 600;
  }

  .valeria-product-card__price-compare {
    opacity: 0.6;
    text-decoration: line-through;
  }

  .valeria-quick-add {
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .valeria-product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Number of products"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
