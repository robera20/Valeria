{%- comment -%}
  Renders a product price
  Accepts: product
{%- endcomment -%}

<div class="valeria-price">
  {%- if product.compare_at_price > product.price -%}
    <span class="valeria-price__compare">{{ product.compare_at_price | money }}</span>
    <span class="valeria-price__current">{{ product.price | money }}</span>
  {%- else -%}
    <span class="valeria-price__current">{{ product.price | money }}</span>
  {%- endif -%}
</div>
