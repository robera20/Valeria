      {
        "type": "text",
        "id": "social_facebook",
        "label": "t:settings_schema.social_facebook",
        "placeholder": "https://facebook.com/yourstore"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "t:settings_schema.social_tiktok",
        "placeholder": "https://tiktok.com/@yourstore"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "t:settings_schema.social_youtube",
        "placeholder": "https://youtube.com/@yourstore"
      }
